{
  "name": "@kungbib/bootstrap-styles",
  "version": "3.0.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Stylesheets for use in development at the National Library of Sweden",
  "files": [
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Kungbib/styles.git"
  },
  "author": "Kungliga biblioteket",
  "contributors": [
    {
      "name": "Mattias Bolin",
      "email": "bolin.mattias@gmail.com"
    },
    {
      "name": "Ola Blissing",
      "email": "ola.blissing@gmail.com"
    },
    {
      "name": "Krzysztof Bergendahl",
      "email": "krzysztof.bergendahl@gmail.com"
    }
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "scripts": {
    "prepack": "npm run clear_lib && npm run copy_sass && npm run build_styles && npm run build_assets",
    "clear_lib": "rm -rf ./lib && mkdir ./lib",
    "copy_sass": "cp -r ./src/styles/. ./lib/scss",
    "build_styles": "sass ./src/styles/theme.scss ./lib/css/theme.css",
    "build_assets": "mkdir ./lib/assets && cp -r ./src/assets/. ./lib/assets"
  },
  "devDependencies": {
    "sass": "^1.83.4"
  },
  "directories": {
    "lib": "lib"
  },
  "bugs": {
    "url": "https://github.com/Kungbib/styles/issues"
  },
  "homepage": "https://github.com/Kungbib/styles#readme"
}
